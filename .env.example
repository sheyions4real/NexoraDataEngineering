
# Application
APP_NAME=NexoraDataEngineering
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# SQL Server source
DB_SERVER=localhost
DB_DATABASE=NexoraEnterprise
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Azure Data Lake Gen2
AZURE_STORAGE_ACCOUNT_URL=https://stnexoradatalake.dfs.core.windows.net
AZURE_STORAGE_FILESYSTEM=nexora


# Source schemas to discover (comma-separated)
SOURCE_SCHEMAS=Sales
BRONZE_TABLES=Sales.SalesOrders,Sales.Products,HR.Employees


# Extraction
EXTRACTION_BATCH_SIZE=10000

# Data lake layout
BRONZE_ROOT_PATH=bronze
AUDIT_ROOT_PATH=audit